---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CF_ANALYTICS_TOKEN } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	/** Defaults to 'en' — only post pages have a real value to pass, via
	 * `post.data.lang` (see PostLayout.astro). */
	lang?: 'en' | 'de';
}

const { title, description, image, type, publishedTime, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
		/>
	</head>
	<body class="flex min-h-screen flex-col font-sans">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-white"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" class="page-container flex-1 py-10">
			<slot />
		</main>
		<Footer />
		{
			import.meta.env.PROD && CF_ANALYTICS_TOKEN && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
				/>
			)
		}
	</body>
</html>
