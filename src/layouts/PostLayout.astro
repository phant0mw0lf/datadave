---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagPill from '../components/TagPill.astro';
import { SITE } from '../consts';
import { getPosts, readingTime } from '../lib/posts';

interface Props {
	post: CollectionEntry<'blog'>;
	headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, lang } = post.data;
const minutes = readingTime(post.body ?? '');

// "On this page" only earns its space on posts with real structure — h2
// sections only (h3s would make it a wall), and at least three of them.
const toc = headings.filter((heading) => heading.depth === 2);
const showToc = toc.length >= 3;

// Newest-first already (getPosts sorts); posts sharing at least one tag,
// self excluded. Renders nothing when there's no overlap.
const related = (await getPosts())
	.filter((other) => other.id !== post.id && other.data.tags.some((tag) => tags.includes(tag)))
	.slice(0, 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: { '@type': 'Person', name: SITE.author },
};
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage?.src ?? `/og/${post.id}.png`}
	type="article"
	publishedTime={pubDate.toISOString()}
	lang={lang}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	<article class="max-w-none">
		<a href="/blog" class="font-mono text-xs text-fg-muted transition-colors hover:text-fg">
			&larr; Blog
		</a>
		<header class="mt-3 mb-8">
			<h1
				class="text-balance font-display text-3xl leading-tight font-semibold tracking-tight text-fg sm:text-4xl"
			>
				{title}
			</h1>
			<div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-fg-muted">
				<FormattedDate date={pubDate} lang={lang} />
				<span aria-hidden="true">&middot;</span>
				<span>{minutes}</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">&middot;</span>
							<span>
								Updated <FormattedDate date={updatedDate} lang={lang} />
							</span>
						</>
					)
				}
				{tags.map((tag) => <TagPill tag={tag} />)}
			</div>
		</header>
		{
			showToc && (
				<nav
					class="mb-8 rounded-lg border border-border bg-surface px-4 py-3"
					aria-label="Table of contents"
				>
					<div class="font-mono text-2xs tracking-wider text-fg-muted uppercase">On this page</div>
					<ul class="mt-2 space-y-1 text-sm">
						{toc.map((heading) => (
							<li>
								<a
									href={`#${heading.slug}`}
									class="text-fg-muted transition-colors hover:text-accent"
								>
									{heading.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
		<!-- alt="" below is intentional: hero images are decorative by policy
		     on this blog (the title/dek already carries the meaning) — there's
		     no per-post alt-text field in the content schema on purpose. -->
		{
			heroImage && (
				<Image
					src={heroImage}
					alt=""
					class="mb-8 aspect-video w-full rounded-lg border border-border object-cover"
					widths={[400, 800, 1200]}
					sizes="(min-width: 640px) 42rem, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
			)
		}
		<div class="prose dark:prose-invert max-w-none">
			<slot />
		</div>
		{
			related.length > 0 && (
				<aside class="mt-12 border-t border-border pt-6" aria-label="Related posts">
					<div class="font-mono text-2xs tracking-wider text-fg-muted uppercase">Related posts</div>
					<ul class="mt-3 space-y-2">
						{related.map((other) => (
							<li class="flex flex-wrap items-baseline gap-x-3">
								<a
									href={`/blog/${other.id}/`}
									class="text-sm font-medium text-fg transition-colors hover:text-accent"
								>
									{other.data.title}
								</a>
								<span class="font-mono text-xs text-fg-muted">
									<FormattedDate date={other.data.pubDate} lang={other.data.lang} />
								</span>
							</li>
						))}
					</ul>
				</aside>
			)
		}
	</article>
</BaseLayout>

<script>
	// Wraps each Shiki-rendered code block with a toolbar showing the fenced
	// language (Shiki already puts it on `data-language`) and a copy button.
	// Runs once on load — the cross-document view transitions in global.css
	// are CSS-only (no client router), so every navigation is still a full
	// document load and this re-runs naturally.
	function enhanceCodeBlocks() {
		document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
			if (pre.parentElement?.classList.contains('code-block')) return;

			const wrapper = document.createElement('div');
			wrapper.className = 'code-block';
			pre.replaceWith(wrapper);
			wrapper.appendChild(pre);

			const toolbar = document.createElement('div');
			toolbar.className = 'code-block-toolbar';

			const lang = pre.dataset.language;
			if (lang) {
				const langLabel = document.createElement('span');
				langLabel.className = 'code-block-lang';
				langLabel.textContent = lang;
				toolbar.appendChild(langLabel);
			} else {
				toolbar.appendChild(document.createElement('span'));
			}

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'code-block-copy';
			button.textContent = 'Copy';
			button.setAttribute('aria-label', lang ? `Copy ${lang} code` : 'Copy code');
			toolbar.appendChild(button);

			// Visually-hidden live region for the Copied/Failed result — the
			// button's own text already shows it sighted, but with several
			// blocks on one post every button's accessible name would
			// otherwise just be "Copy", so a screen reader has no way to
			// hear which one just changed state.
			const status = document.createElement('span');
			status.className = 'sr-only';
			status.setAttribute('role', 'status');
			status.setAttribute('aria-live', 'polite');
			toolbar.appendChild(status);

			let resetTimer: ReturnType<typeof setTimeout> | undefined;
			button.addEventListener('click', async () => {
				clearTimeout(resetTimer);
				try {
					await navigator.clipboard.writeText(pre.textContent ?? '');
					button.textContent = 'Copied';
					button.classList.add('copied');
					status.textContent = 'Copied to clipboard';
				} catch {
					button.textContent = 'Failed to copy';
					status.textContent = 'Failed to copy';
				}
				resetTimer = setTimeout(() => {
					button.textContent = 'Copy';
					button.classList.remove('copied');
					status.textContent = '';
				}, 1500);
			});

			wrapper.insertBefore(toolbar, pre);
		});
	}

	enhanceCodeBlocks();
</script>
