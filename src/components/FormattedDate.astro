---
interface Props {
	date: Date;
	/** Post's `lang` frontmatter field — controls date formatting locale.
	 * Defaults to 'en' since only English posts exist today; German posts
	 * will pass their own `post.data.lang` once they exist. */
	lang?: 'en' | 'de';
}

const { date, lang = 'en' } = Astro.props;
const locale = lang === 'de' ? 'de-DE' : 'en-US';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>
