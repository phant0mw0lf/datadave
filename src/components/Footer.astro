---
import { SITE } from '../consts';

const year = new Date().getFullYear();

const links = [
	{
		href: SITE.github,
		label: 'GitHub',
		external: true,
		icon: 'M12 .5C5.73.5.98 5.24.98 11.5c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.16.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.71.08-.7.08-.7 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.53-.29-5.19-1.26-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.14 1.17.91-.25 1.89-.38 2.86-.38.97 0 1.95.13 2.86.38 2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.75.11 3.04.73.8 1.17 1.82 1.17 3.06 0 4.38-2.67 5.34-5.21 5.62.41.36.77 1.06.77 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A11.02 11.02 0 0 0 23 11.5C23 5.24 18.27.5 12 .5Z',
	},
	{
		href: SITE.linkedin,
		label: 'LinkedIn',
		external: true,
		icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
	},
	{
		href: `mailto:${SITE.email}`,
		label: 'Email',
		external: false,
		icon: 'M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-10.5 6.3-10.5-6.3ZM22.5 6.75A2.25 2.25 0 0 0 20.25 4.5H3.75A2.25 2.25 0 0 0 1.5 6.75v.383l10.5 6.3 10.5-6.3V6.75Z',
	},
	{
		href: '/rss.xml',
		label: 'RSS',
		external: false,
		icon: 'M3 3c9.941 0 18 8.059 18 18h-3c0-8.284-6.716-15-15-15V3zm0 7c6.075 0 11 4.925 11 11h-3a8 8 0 0 0-8-8v-3zm2 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
	},
];
---

<footer class="border-t border-border">
	<div
		class="page-container flex flex-col items-center gap-3 py-8 text-sm text-fg-muted sm:flex-row sm:justify-between"
	>
		<p class="font-mono text-xs">&copy; {year} {SITE.author}</p>
		<nav class="flex items-center gap-4">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-fg-muted transition-colors hover:text-fg"
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
					>
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
							<path d={link.icon} />
						</svg>
						<span class="sr-only">{link.label}</span>
					</a>
				))
			}
		</nav>
	</div>
</footer>
