---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkCard from '../../components/TalkCard.astro';
import { getTalks, isUpcoming } from '../../lib/talks';

const talks = await getTalks();
// Upcoming soonest-first (the next one is what you're looking for), past
// newest-first. Group labels only render when both groups have entries.
const upcoming = talks.filter((talk) => isUpcoming(talk)).reverse();
const past = talks.filter((talk) => !isUpcoming(talk));
const groups = [
	{ label: 'Upcoming', talks: upcoming },
	{ label: 'Past', talks: past },
].filter((group) => group.talks.length > 0);
const showLabels = groups.length > 1;
---

<BaseLayout
	title="Talks"
	description="Meetup and conference talks — slides, demo code and notebooks."
>
	<h1 class="font-display text-2xl font-semibold tracking-tight text-fg sm:text-3xl">Talks</h1>
	<p class="mt-3 text-sm text-fg-muted">
		Meetups and conferences. Slides, demo code and notebooks for each talk live on its page.
	</p>
	<div class="mt-8">
		{
			groups.map((group) => (
				<section class="mt-8 first:mt-0">
					{showLabels && (
						<h2 class="mb-1 font-mono text-2xs tracking-wider text-fg-muted uppercase">
							{group.label}
						</h2>
					)}
					{group.talks.map((talk) => (
						<TalkCard talk={talk} />
					))}
				</section>
			))
		}
		{talks.length === 0 && <p class="text-fg-muted">No talks yet — check back soon.</p>}
	</div>
</BaseLayout>
