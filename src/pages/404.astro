---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
	<div class="py-20 text-center">
		<h1 class="font-display text-3xl font-semibold tracking-tight text-fg">404</h1>
		<p class="mt-2 text-fg-muted">This page doesn't exist.</p>
		<a
			href="/"
			class="mt-6 inline-block text-sm text-accent transition-colors hover:underline"
		>
			Back home &rarr;
		</a>
	</div>
</BaseLayout>
