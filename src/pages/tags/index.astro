---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags, getPostsByTag } from '../../lib/posts';
import { tagColorVar } from '../../lib/tagColor';

const tags = await getTags();
const counts = await Promise.all(
	tags.map(async (tag) => ({ tag, count: (await getPostsByTag(tag)).length })),
);
---

<BaseLayout title="Tags" description="All tags.">
	<h1 class="font-display text-2xl font-semibold tracking-tight text-fg sm:text-3xl">Tags</h1>
	<div class="mt-8 flex flex-wrap gap-2">
		{
			counts.map(({ tag, count }) => (
				<a
					href={`/tags/${encodeURIComponent(tag)}/`}
					class="flex items-center gap-2 rounded-full border border-border py-1 pr-3 pl-1 text-sm transition-colors hover:border-fg-muted"
				>
					<span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${tagColorVar(tag)}`} />
					<span class="font-mono text-fg">{tag}</span>
					<span class="font-mono text-xs text-fg-muted">{count}</span>
				</a>
			))
		}
		{tags.length === 0 && <p class="text-fg-muted">No tags yet.</p>}
	</div>
</BaseLayout>
