---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPostsByTag, getTags } from '../../lib/posts';
import { tagColorVar } from '../../lib/tagColor';

export async function getStaticPaths() {
	const tags = await getTags();
	return tags.map((tag) => ({
		params: { tag },
	}));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged "${tag}".`}>
	<div class="flex items-center gap-3">
		<span
			class="rounded-full px-3 py-1 font-mono text-sm font-medium text-white"
			style={`background-color: ${tagColorVar(tag!)}`}
		>
			{tag}
		</span>
		<span class="font-mono text-sm text-fg-muted">
			{posts.length} post{posts.length === 1 ? '' : 's'}
		</span>
	</div>
	<div class="mt-8">
		{posts.map((post) => <PostCard post={post} />)}
	</div>
</BaseLayout>
